# ===== Core =====
FLASK_ENV=dev
# Generate a strong value for production: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production

# ===== Database (PostgreSQL) =====
POSTGRES_USER=easygo
POSTGRES_PASSWORD=easygo
POSTGRES_DB=easygo
DATABASE_URL=postgresql+psycopg://easygo:easygo@db:5432/easygo

# ===== Redis (queue + cache + realtime) =====
REDIS_URL=redis://redis:6379/0

# ===== Secrets encryption (channel tokens, credentials) =====
# Generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FERNET_KEY=

# ===== Media storage =====
MEDIA_ROOT=/data/media

# ===== Public URL for channel webhooks =====
# Telegram must reach your webhook over HTTPS. In dev use a tunnel (ngrok/cloudflared).
# No trailing slash. Example: https://abc123.ngrok-free.app
PUBLIC_BASE_URL=

# ===== Meta channels (Messenger / Instagram) — Phase 2 =====
# One Meta app serves all Pages. Set the callback URL + this verify token in the
# Meta app dashboard; per-Page access tokens are entered later via Settings.
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v21.0

# ===== Email alerts (NT-3) — optional =====
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_FROM=easygo@localhost

# ===== Web Push (NT-2) — optional (VAPID keys) =====
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@localhost

# ===== AI provider (DeepSeek) =====
# These can also be set later from Settings; env values seed the defaults.
AI_PROVIDER=deepseek
AI_MODEL=deepseek-chat
AI_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=

# ===== First admin (created by `flask seed`) =====
ADMIN_EMAIL=admin@easygo.local
ADMIN_PASSWORD=admin12345
ADMIN_NAME=مدير النظام
